[Unit]
Description=Theosis MCP Server - Theological Research AI Interface
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=theosis
Group=theosis
WorkingDirectory=/opt/theosis-mcp
Environment=THEOSIS_DATABASE_URL=postgresql://theosis@/theosis?host=/var/run/postgresql
Environment=PYTHONPATH=/opt/theosis-mcp/src
ExecStart=/opt/theosis-mcp/.venv/bin/python -m theosis_mcp.server --transport streamable-http --host 192.168.1.130 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/theosis-mcp
UMask=027

[Install]
WantedBy=multi-user.target
